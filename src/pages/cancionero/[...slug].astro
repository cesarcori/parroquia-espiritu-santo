---
import { type CollectionEntry, getCollection } from "astro:content";
import CancioneroLayout from "../../layouts/CancioneroLayout.astro";
import { render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("cancion");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}
type Props = CollectionEntry<"cancion">;

const post = Astro.props;
const { Content } = await render(post);
---

<CancioneroLayout {...post.data}>
  <div class="flex justify-end">
    <button class="btn btn-primary flex items-center gap-2" id="download-pdf">
      <span class="max-sm:hidden">Descargar PDF</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="w-6 h-6"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M15 12 12 15m0 0-3-3m3 3V3"
        ></path>
      </svg>
    </button>
  </div>
  <Content />

  <script
    is:inline
    src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"
  ></script>

  <script is:inline define:vars={{ title: post.data.title, body: post.body }}>
    const { jsPDF } = window.jspdf;

    const button = document.getElementById("download-pdf");

    if (button) {
      button.addEventListener("click", () => {
        const doc = new jsPDF({ format: "letter" });

        // Use the variables passed from Astro
        doc.setFontSize(18);
        doc.text(title, 10, 10);

        doc.setFontSize(12);
        const splitText = doc.splitTextToSize(body, 180);
        doc.text(splitText, 10, 20);

        doc.save(`${title}.pdf`);
      });
    }
  </script>
</CancioneroLayout>

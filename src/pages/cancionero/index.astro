---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("cancion")).sort((a, b) =>
  a.id.toLocaleLowerCase().localeCompare(b.id.toLocaleLowerCase())
);

const baseUrl = `${import.meta.env.BASE_URL}`;
---

<BaseLayout>
  <!-- Search Form -->
  <form id="searchForm" class="mb-8">
    <input
      type="text"
      id="searchInput"
      name="searchInput"
      placeholder="Busca la canción"
      class="w-full p-2 border border-gray-300 rounded-md"
    />
  </form>

  <button class="btn btn-primary flex items-center gap-2" id="download-pdf">
    <span class="max-sm:hidden">Descargar PDF</span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.5"
      stroke="currentColor"
      class="w-6 h-6"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M15 12 12 15m0 0-3-3m3 3V3"
      ></path>
    </svg>
  </button>

  <!-- Posts List -->
  <ul id="postsList" class="mt-8 pb-8">
    {
      posts.map((post) => (
        <li
          class="flex justify-center mt-2 post-item"
          data-title={post.data.title.toLowerCase()}
        >
          <a href={`${baseUrl}/cancionero/${post.id}/`}>
            <h4 class="font-bold hover:text-blue-500">{post.data.title}</h4>
          </a>
        </li>
      ))
    }
  </ul>

  <!-- No Results Message (hidden by default) -->
  <div id="noResults" class="hidden text-center text-gray-500 mt-8">
    No se encontraron canciones con ese nombre.
  </div>

  <!-- Clien t-side JavaScript for Search -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const searchInput = document.getElementById("searchInput");
      const postsList = document.getElementById("postsList");
      const postItems = document.querySelectorAll(".post-item");
      const noResults = document.getElementById("noResults");

      // Function to filter posts
      function filterPosts() {
        const searchTerm = searchInput.value.toLowerCase().trim();
        let hasVisibleItems = false;

        postItems.forEach((item) => {
          const title = item.getAttribute("data-title");
          const isVisible = title.includes(searchTerm);

          item.style.display = isVisible ? "flex" : "none";
          if (isVisible) hasVisibleItems = true;
        });

        // Show/hide no results message
        if (searchTerm && !hasVisibleItems) {
          noResults.classList.remove("hidden");
          postsList.classList.add("hidden");
        } else {
          noResults.classList.add("hidden");
          postsList.classList.remove("hidden");
        }
      }

      // Add event listener for input
      searchInput.addEventListener("input", filterPosts);

      // Optional: Pre-fill with example if needed
      // searchInput.value = "señor ten piedad";
      // filterPosts(); // Uncomment to auto-filter on load
    });
  </script>

  <script
    is:inline
    src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"
  ></script>

  <script is:inline define:vars={{ posts: posts }}>
    const TITULO_CANCIONERO = "Cancionero Parróquia Espíritu Santo";
    const { jsPDF } = window.jspdf;

    const button = document.getElementById("download-pdf");

    function generateSong(objDoc, post, startY) {
      let currentY = startY;
      const pageHeight = objDoc.internal.pageSize.height;
      const margin = 10;
      const lineHeight = 6;

      // Title
      if (currentY + 10 > pageHeight - margin) {
        objDoc.addPage();
        currentY = margin;
      }

      objDoc.setFontSize(18);
      objDoc.text(post?.data?.title || "", margin, currentY);
      currentY += 10;

      // Body
      objDoc.setFontSize(11);
      const splitText = objDoc.splitTextToSize(post?.body || "", 180);

      splitText.forEach((line) => {
        // If next line doesn't fit → new page
        if (currentY + lineHeight > pageHeight - margin) {
          objDoc.addPage();
          currentY = margin;
        }

        objDoc.text(line, margin, currentY);
        currentY += lineHeight;
      });

      // Space between songs
      currentY += 8;

      return currentY;
    }

    if (button) {
      button.addEventListener("click", () => {
        const doc = new jsPDF({ format: "letter" });
        let currentY = 10;

        posts.forEach((post) => {
          currentY = generateSong(doc, post, currentY);
        });

        doc.save(`${TITULO_CANCIONERO}.pdf`);
      });
    }
  </script>
</BaseLayout>

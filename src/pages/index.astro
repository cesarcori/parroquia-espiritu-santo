---
import BaseLayout from "../layouts/BaseLayout.astro";
const baseUrl = `${import.meta.env.BASE_URL}`;
---

<BaseLayout>
	<div class="text-title">Bienvenido a la Parroquia Espíritu Santo</div>
	<!-- class="h-[50vh] object-cover mask-radial-at-center mask-radial-from-50% mask-radial-to-80% max-sm:mx-auto" -->
	<img
		class="mt-4 h-[50vh] mask-x-from-90% mask-y-from-90% mx-auto"
		alt="imagen de la parroquia espíritu santo"
		src={`${baseUrl}/imagen-principal.jpg`}
	/>
	<p class="mx-auto max-w-4xl">
		Forma parte de nuestra querida comunidad espiritual, donde podrás
		experimentar la fe y nutrirte con las enseñanzas de Dios, Jesucristo y el
		Espíritu Santo.
	</p>
</BaseLayout>
